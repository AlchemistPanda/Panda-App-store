#!/usr/bin/env python3
"""Publish an APK to Panda App Store.

Usage: panda-publish <app.apk> [--notes "what changed"] [--dry-run]
                                [--allow-new-signer] [--no-notify]
                                [--icon FILE.png] [--icon-only]

--icon      use this image as the store icon instead of reading one from the APK
--icon-only refresh just the store icon (and catalog entry) for the app already
            published from this APK's package; no release, no push

Reads package/version/build number/label/icon/signer straight from the APK,
uploads it as a GitHub release, updates catalog.json on the catalog branch,
deletes that app's releases beyond the newest `keepReleases`, and sends an
ntfy push so the phone knows there is an update.

Config: ~/.config/panda-store/config.json (kept out of the public repo because
it holds the ntfy topic).
"""

import argparse
import base64
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import zipfile
from datetime import datetime, timezone
from pathlib import Path

CONFIG_PATH = Path.home() / ".config/panda-store/config.json"
SDK = Path(os.environ.get("ANDROID_HOME", Path.home() / "Library/Android/sdk"))
DENSITY_ORDER = ["xxxhdpi", "xxhdpi", "xhdpi", "hdpi", "mdpi", "ldpi"]


def die(msg, code=1):
    print(f"panda-publish: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, **kw):
    res = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if res.returncode != 0:
        die(f"command failed: {' '.join(map(str, cmd))}\n{res.stderr.strip()}")
    return res.stdout


def build_tool(name):
    tools_dir = SDK / "build-tools"
    if not tools_dir.is_dir():
        die(f"Android build-tools not found under {SDK}")
    versions = sorted(
        (d for d in tools_dir.iterdir() if (d / name).exists()),
        key=lambda d: [int(x) if x.isdigit() else 0 for x in re.split(r"[.-]", d.name)],
    )
    if not versions:
        die(f"{name} not found in {tools_dir}")
    return str(versions[-1] / name)


# ---------- APK inspection ----------

def read_apk(apk):
    badging = run([build_tool("aapt2"), "dump", "badging", str(apk)])
    pkg = re.search(r"^package: name='([^']+)' versionCode='(\d+)' versionName='([^']*)'", badging, re.M)
    if not pkg:
        die("could not read package info from the APK")
    label = re.search(r"^application-label:'([^']*)'", badging, re.M)
    icon = re.search(r"^application: label='[^']*' icon='([^']+)'", badging, re.M)
    min_sdk = re.search(r"^(?:minSdkVersion|sdkVersion):'(\d+)'", badging, re.M)
    target_sdk = re.search(r"^targetSdkVersion:'(\d+)'", badging, re.M)

    certs = run([build_tool("apksigner"), "verify", "--print-certs", str(apk)])
    signer = re.search(r"certificate SHA-256 digest: ([0-9a-f]+)", certs)
    if not signer:
        die("APK is not signed (apksigner found no certificate)")

    sha = hashlib.sha256()
    with open(apk, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            sha.update(chunk)

    return {
        "packageName": pkg.group(1),
        "versionCode": int(pkg.group(2)),
        "versionName": pkg.group(3),
        "name": label.group(1) if label else pkg.group(1),
        "iconPath": icon.group(1) if icon else None,
        "minSdk": int(min_sdk.group(1)) if min_sdk else None,
        "targetSdk": int(target_sdk.group(1)) if target_sdk else None,
        "signerSha256": signer.group(1),
        "sha256": sha.hexdigest(),
        "size": apk.stat().st_size,
    }


def extract_icon(apk, icon_path):
    """Return (bytes, ext) of the best bitmap launcher icon, or None.

    Adaptive icons are XML, so look up the resource that points at the icon
    path and take its highest-density png/webp variant instead.
    """
    if not icon_path:
        return None
    candidate = icon_path
    if icon_path.endswith(".xml"):
        dump = run([build_tool("aapt2"), "dump", "resources", str(apk)])
        blocks = re.split(r"^\s*resource 0x", dump, flags=re.M)
        block = next((b for b in blocks if f"(file) {icon_path}" in b), None)
        if not block:
            return None
        files = dict(re.findall(r"\(([^)]*)\) \(file\) (\S+\.(?:png|webp))", block))
        if not files:
            drawn = render_adaptive_icon(apk, icon_path)
            return (drawn, "png") if drawn else None
        candidate = None
        for density in DENSITY_ORDER:
            match = next((p for cfg, p in files.items() if density in cfg.split("-")), None)
            if match:
                candidate = match
                break
        if not candidate and files:
            candidate = next(iter(files.values()))
        if not candidate:
            return None
    with zipfile.ZipFile(apk) as z:
        try:
            data = z.read(candidate)
        except KeyError:
            return None
    return data, candidate.rsplit(".", 1)[-1]


# ---------- vector launcher icons ----------
#
# Many apps declare an adaptive icon whose foreground is a VectorDrawable, so
# there is no bitmap anywhere in the APK to pull out. Render it ourselves:
# background colour/bitmap + foreground vector, cropped to the visible area and
# rounded. Supports the path commands M L H V C S Q T A Z with fill and stroke,
# which covers hand-drawn launcher vectors. Anything fancier (groups, clip
# paths, gradients) returns None and the publisher then says so loudly.

def _parse_color(value):
    m = re.fullmatch(r"#([0-9a-fA-F]{8}|[0-9a-fA-F]{6})", value.strip())
    if not m:
        return None
    h = m.group(1)
    if len(h) == 6:
        h = "ff" + h
    a, r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4, 6))
    return (r, g, b, a)


def _arc_points(x1, y1, rx, ry, phi, fa, fs, x2, y2, steps=32):
    import math
    if rx == 0 or ry == 0 or (x1 == x2 and y1 == y2):
        return [(x2, y2)]
    rx, ry = abs(rx), abs(ry)
    cp, sp = math.cos(math.radians(phi)), math.sin(math.radians(phi))
    dx, dy = (x1 - x2) / 2, (y1 - y2) / 2
    x1p, y1p = cp * dx + sp * dy, -sp * dx + cp * dy
    lam = x1p ** 2 / rx ** 2 + y1p ** 2 / ry ** 2
    if lam > 1:
        rx, ry = rx * math.sqrt(lam), ry * math.sqrt(lam)
    num = rx ** 2 * ry ** 2 - rx ** 2 * y1p ** 2 - ry ** 2 * x1p ** 2
    den = rx ** 2 * y1p ** 2 + ry ** 2 * x1p ** 2
    co = math.sqrt(max(0, num / den)) * (-1 if fa == fs else 1)
    cxp, cyp = co * rx * y1p / ry, -co * ry * x1p / rx
    cx = cp * cxp - sp * cyp + (x1 + x2) / 2
    cy = sp * cxp + cp * cyp + (y1 + y2) / 2

    def ang(ux, uy, vx, vy):
        a = math.atan2(ux * vy - uy * vx, ux * vx + uy * vy)
        return a
    th1 = ang(1, 0, (x1p - cxp) / rx, (y1p - cyp) / ry)
    dth = ang((x1p - cxp) / rx, (y1p - cyp) / ry, (-x1p - cxp) / rx, (-y1p - cyp) / ry)
    if not fs and dth > 0:
        dth -= 2 * math.pi
    elif fs and dth < 0:
        dth += 2 * math.pi
    pts = []
    for i in range(1, steps + 1):
        t = th1 + dth * i / steps
        x, y = rx * math.cos(t), ry * math.sin(t)
        pts.append((cp * x - sp * y + cx, sp * x + cp * y + cy))
    return pts


def _flatten_path(d):
    """Path data -> list of (points, closed) subpaths in viewport units."""
    toks = re.findall(r"[MmLlHhVvCcSsQqTtAaZz]|[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?", d)
    subs, cur, closed = [], [], False
    i, cmd = 0, None
    x = y = sx = sy = 0.0
    lastc = None  # last control point, for S / T

    def num():
        nonlocal i
        v = float(toks[i]); i += 1
        return v

    def bez(p0, c1, c2, p3, n=24):
        out = []
        for k in range(1, n + 1):
            t = k / n; u = 1 - t
            out.append((u**3 * p0[0] + 3*u*u*t * c1[0] + 3*u*t*t * c2[0] + t**3 * p3[0],
                        u**3 * p0[1] + 3*u*u*t * c1[1] + 3*u*t*t * c2[1] + t**3 * p3[1]))
        return out

    while i < len(toks):
        if re.fullmatch(r"[A-Za-z]", toks[i]):
            cmd = toks[i]; i += 1
            if cmd in "Zz":
                if cur:
                    subs.append((cur, True))
                cur, x, y = [], sx, sy
                continue
        rel = cmd.islower()
        c = cmd.upper()
        if c == "M":
            nx, ny = num(), num()
            if rel: nx, ny = x + nx, y + ny
            if cur: subs.append((cur, False))
            x, y, sx, sy = nx, ny, nx, ny
            cur = [(x, y)]
            cmd = "l" if rel else "L"
            lastc = None
        elif c == "L":
            nx, ny = num(), num()
            if rel: nx, ny = x + nx, y + ny
            x, y = nx, ny; cur.append((x, y)); lastc = None
        elif c == "H":
            nx = num(); x = x + nx if rel else nx; cur.append((x, y)); lastc = None
        elif c == "V":
            ny = num(); y = y + ny if rel else ny; cur.append((x, y)); lastc = None
        elif c in "CS":
            if c == "C":
                c1 = (num(), num())
                if rel: c1 = (x + c1[0], y + c1[1])
            else:
                c1 = (2 * x - lastc[0], 2 * y - lastc[1]) if lastc else (x, y)
            c2 = (num(), num()); p = (num(), num())
            if rel:
                c2 = (x + c2[0], y + c2[1]); p = (x + p[0], y + p[1])
            cur += bez((x, y), c1, c2, p); lastc = c2; x, y = p
        elif c in "QT":
            if c == "Q":
                q = (num(), num())
                if rel: q = (x + q[0], y + q[1])
            else:
                q = (2 * x - lastc[0], 2 * y - lastc[1]) if lastc else (x, y)
            p = (num(), num())
            if rel: p = (x + p[0], y + p[1])
            cur += bez((x, y), (x + 2*(q[0]-x)/3, y + 2*(q[1]-y)/3),
                       (p[0] + 2*(q[0]-p[0])/3, p[1] + 2*(q[1]-p[1])/3), p)
            lastc = q; x, y = p
        elif c == "A":
            rx, ry, phi, fa, fs = num(), num(), num(), int(num()), int(num())
            p = (num(), num())
            if rel: p = (x + p[0], y + p[1])
            cur += _arc_points(x, y, rx, ry, phi, fa, fs, p[0], p[1]); x, y = p; lastc = None
        else:
            raise ValueError(f"unsupported path command {cmd}")
    if cur:
        subs.append((cur, False))
    return subs


def _res_table(apk):
    """resource id -> list of (config, value) from `aapt2 dump resources`."""
    table = {}
    dump = run([build_tool("aapt2"), "dump", "resources", str(apk)])
    for block in re.split(r"^\s*resource (?=0x)", dump, flags=re.M)[1:]:
        lines = block.splitlines()
        rid = lines[0].split()[0]
        vals = []
        for ln in lines[1:]:
            m = re.match(r"\s*\(([^)]*)\)\s+(.*)", ln)
            if m:
                vals.append((m.group(1), m.group(2).strip()))
        table[rid] = vals
    return table


def _layer_image(apk, table, ref, size):
    """RGBA image of one adaptive-icon layer, or None if it can't be drawn."""
    from PIL import Image, ImageDraw
    import io
    vals = table.get(ref)
    if not vals:
        return None
    value = vals[-1][1]
    color = _parse_color(value)
    if color:
        return Image.new("RGBA", (size, size), color)
    m = re.match(r"\(file\) (\S+)", value)
    if not m:
        return None
    path = m.group(1)
    if path.endswith((".png", ".webp")):
        with zipfile.ZipFile(apk) as z:
            return Image.open(io.BytesIO(z.read(path))).convert("RGBA").resize((size, size))
    if not path.endswith(".xml"):
        return None
    xml = run([build_tool("aapt2"), "dump", "xmltree", "--file", path, str(apk)])
    if re.search(r"E: (group|clip-path)", xml) or "gradient" in xml:
        return None
    vw = re.search(r"viewportWidth\(0x[0-9a-f]+\)=([\d.]+)", xml)
    vh = re.search(r"viewportHeight\(0x[0-9a-f]+\)=([\d.]+)", xml)
    if not vw or not vh or "E: vector" not in xml:
        return None
    sx, sy = size / float(vw.group(1)), size / float(vh.group(1))
    img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
    draw = ImageDraw.Draw(img, "RGBA")
    for chunk in re.split(r"^\s*E: path.*$", xml, flags=re.M)[1:]:
        attr = {k: v for k, v in re.findall(r"android:(\w+)\(0x[0-9a-f]+\)=(\"[^\"]*\"|\S+)", chunk.split("\n      E:")[0])}
        d = attr.get("pathData", "").split("\" (Raw")[0].strip('"')
        if not d:
            continue
        fill = _parse_color(attr.get("fillColor", ""))
        stroke = _parse_color(attr.get("strokeColor", ""))
        sw = float(attr.get("strokeWidth", "0") or 0)
        for pts, is_closed in _flatten_path(d):
            px = [(a * sx, b * sy) for a, b in pts]
            if fill and len(px) > 2:
                draw.polygon(px, fill=fill)
            if stroke and sw > 0 and len(px) > 1:
                draw.line(px + ([px[0]] if is_closed else []), fill=stroke,
                          width=max(1, round(sw * sx)), joint="curve")
    return img


def render_adaptive_icon(apk, icon_path, out=192):
    """Draw an adaptive-icon XML (background + foreground) to PNG bytes, or None."""
    try:
        from PIL import Image, ImageDraw
        import io
        xml = run([build_tool("aapt2"), "dump", "xmltree", "--file", icon_path, str(apk)])
        refs, layer = {}, None
        for ln in xml.splitlines():
            m = re.match(r"\s*E: ([\w-]+)", ln)
            if m:
                layer = m.group(1)
            m = re.search(r"drawable\(0x[0-9a-f]+\)=@(0x[0-9a-f]+)", ln)
            if m and layer in ("background", "foreground"):
                refs[layer] = m.group(1)
        if "foreground" not in refs:
            return None
        big = out * 4  # supersample, then shrink for smooth edges
        table = _res_table(apk)
        fg = _layer_image(apk, table, refs["foreground"], big)
        if fg is None:
            return None
        bg = _layer_image(apk, table, refs["background"], big) if "background" in refs else None
        canvas = bg or Image.new("RGBA", (big, big), (255, 255, 255, 255))
        canvas.alpha_composite(fg)
        lo, hi = round(big * 18 / 108), round(big * 90 / 108)  # the 72dp visible window
        canvas = canvas.crop((lo, lo, hi, hi)).resize((out, out), Image.LANCZOS)
        mask = Image.new("L", (out * 4, out * 4), 0)
        ImageDraw.Draw(mask).rounded_rectangle((0, 0, out * 4 - 1, out * 4 - 1), radius=out * 4 * 0.22, fill=255)
        canvas.putalpha(mask.resize((out, out), Image.LANCZOS))
        buf = io.BytesIO()
        canvas.save(buf, "PNG")
        return buf.getvalue()
    except Exception as e:  # never let icon drawing break a publish
        print(f"warning: could not draw the vector icon: {e}", file=sys.stderr)
        return None



def resolve_icon(apk, info, override=None):
    """(bytes, ext) for the store icon: the --icon file if given, else read from the APK."""
    if override:
        f = Path(override).expanduser()
        if not f.is_file() or f.suffix.lower() not in (".png", ".webp", ".jpg", ".jpeg"):
            die(f"--icon must be a png/webp/jpg file: {f}")
        return f.read_bytes(), f.suffix.lower().lstrip(".").replace("jpeg", "jpg")
    return extract_icon(apk, info["iconPath"])

# ---------- GitHub ----------

def gh(*args, input_data=None):
    res = subprocess.run(["gh", *args], capture_output=True, text=True, input=input_data)
    return res


def get_file(repo, branch, path):
    """Return (bytes, blob_sha) or (None, None) if the file does not exist."""
    res = gh("api", f"repos/{repo}/contents/{path}?ref={branch}")
    if res.returncode != 0:
        if "Not Found" in res.stderr or "404" in res.stderr:
            return None, None
        die(f"could not read {path} from {repo}@{branch}\n{res.stderr.strip()}")
    meta = json.loads(res.stdout)
    if meta.get("encoding") == "base64" and meta.get("content"):
        return base64.b64decode(meta["content"]), meta["sha"]
    raw = gh("api", "-H", "Accept: application/vnd.github.raw", f"repos/{repo}/contents/{path}?ref={branch}")
    return raw.stdout.encode(), meta["sha"]


def put_file(repo, branch, path, data, message, sha=None):
    body = {"message": message, "content": base64.b64encode(data).decode(), "branch": branch}
    if sha:
        body["sha"] = sha
    res = gh("api", "-X", "PUT", f"repos/{repo}/contents/{path}", "--input", "-", input_data=json.dumps(body))
    if res.returncode != 0:
        die(f"could not write {path} to {repo}@{branch}\n{res.stderr.strip()}")


def git_blob_sha(data):
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


# ---------- main ----------

def main():
    ap = argparse.ArgumentParser(description="Publish an APK to Panda App Store")
    ap.add_argument("apk", type=Path)
    ap.add_argument("--notes", default=None, help="what changed in this build")
    ap.add_argument("--dry-run", action="store_true", help="inspect and validate only")
    ap.add_argument("--allow-new-signer", action="store_true",
                    help="publish even though the signing key changed (phone must uninstall first)")
    ap.add_argument("--no-notify", action="store_true", help="skip the ntfy push")
    ap.add_argument("--icon", type=Path, default=None, help="image to use as the store icon")
    ap.add_argument("--icon-only", action="store_true",
                    help="update only the store icon for the already-published app")
    args = ap.parse_args()

    if not CONFIG_PATH.exists():
        die(f"missing config {CONFIG_PATH}")
    cfg = json.loads(CONFIG_PATH.read_text())
    repo, branch = cfg["repo"], cfg.get("catalogBranch", "store")
    keep = int(cfg.get("keepReleases", 2))

    apk = args.apk.expanduser().resolve()
    if not apk.is_file() or apk.suffix != ".apk":
        die(f"not an APK: {apk}")
    if not shutil.which("gh"):
        die("GitHub CLI (gh) not installed")
    if gh("auth", "status").returncode != 0:
        die("gh is not logged in — run: gh auth login")

    info = read_apk(apk)
    pkg, code, name = info["packageName"], info["versionCode"], info["versionName"]
    print(f"{info['name']}  {pkg}  v{name}  build {code}  {info['size'] / 1e6:.1f} MB")

    # Validate against the catalog.
    raw, catalog_sha = get_file(repo, branch, "catalog.json")
    catalog = json.loads(raw) if raw else {"schema": 1, "apps": []}
    app = next((a for a in catalog["apps"] if a["packageName"] == pkg), None)

    if args.icon_only:
        if not app:
            die(f"{pkg} is not in the catalog yet; publish it first")
        icon = resolve_icon(apk, info, args.icon)
        if not icon:
            die("no icon could be read from the APK; pass --icon FILE.png")
        data, ext = icon
        icon_path = f"icons/{pkg}.{ext}"
        _, existing_sha = get_file(repo, branch, icon_path)
        if existing_sha != git_blob_sha(data):
            put_file(repo, branch, icon_path, data, f"Icon for {info['name']}", existing_sha)
        new_url = f"https://raw.githubusercontent.com/{repo}/{branch}/{icon_path}"
        if app.get("iconUrl") != new_url:
            app["iconUrl"] = new_url
            put_file(repo, branch, "catalog.json", (json.dumps(catalog, indent=2) + "\n").encode(),
                     f"Icon for {info['name']}", catalog_sha)
        print(f"icon updated for {info['name']}: {new_url}")
        return
    if app and app.get("releases"):
        latest = app["releases"][0]
        if code <= latest["versionCode"]:
            die(f"build number {code} is not higher than the published build "
                f"{latest['versionCode']} (v{latest['versionName']}). Bump versionCode and rebuild.", 2)
        if latest["signerSha256"] != info["signerSha256"] and not args.allow_new_signer:
            die("this APK is signed with a different key than the published build, so it cannot "
                "update the installed app. Sign it with the original keystore, or pass "
                "--allow-new-signer (the phone will have to uninstall the old app first).", 3)

    if args.dry_run:
        print("dry run: validation passed, nothing published")
        return

    tag = f"{pkg}-v{name}-b{code}"
    notes = args.notes or f"Version {name} (build {code})"
    released_at = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")

    with tempfile.TemporaryDirectory(prefix="panda-publish-") as tmp:
        # Upload the APK as a release.
        notes_file = Path(tmp) / "notes.md"
        notes_file.write_text(notes)
        print(f"uploading release {tag} …")
        res = gh("release", "create", tag, str(apk), "--repo", repo,
                 "--title", f"{info['name']} {name} (build {code})", "--notes-file", str(notes_file))
        if res.returncode != 0:
            die(f"release upload failed\n{res.stderr.strip()}")
        apk_url = f"https://github.com/{repo}/releases/download/{tag}/{apk.name.replace(' ', '.')}"

        # Icon (only rewritten when it changed).
        icon_url = app.get("iconUrl") if app else None
        icon = resolve_icon(apk, info, args.icon)
        if not icon:
            print("WARNING: no store icon could be read from this APK, so the store will show "
                  "none. Re-run with --icon FILE.png (or --icon-only) to set one.", file=sys.stderr)
        if icon:
            data, ext = icon
            icon_path = f"icons/{pkg}.{ext}"
            _, existing_sha = get_file(repo, branch, icon_path)
            if existing_sha != git_blob_sha(data):
                put_file(repo, branch, icon_path, data, f"Icon for {info['name']}", existing_sha)
            icon_url = f"https://raw.githubusercontent.com/{repo}/{branch}/{icon_path}"

    # Update the catalog: newest release first, keep only `keep`.
    release = {
        "versionName": name, "versionCode": code, "tag": tag,
        "apkUrl": apk_url, "size": info["size"], "sha256": info["sha256"],
        "signerSha256": info["signerSha256"], "minSdk": info["minSdk"],
        "targetSdk": info["targetSdk"], "releasedAt": released_at, "notes": notes,
    }
    if not app:
        app = {"packageName": pkg, "releases": []}
        catalog["apps"].append(app)
    app["name"] = info["name"]
    app["iconUrl"] = icon_url
    app["updatedAt"] = released_at
    app["releases"] = [release] + app["releases"]
    dropped = app["releases"][keep:]
    app["releases"] = app["releases"][:keep]
    catalog["apps"].sort(key=lambda a: a["name"].lower())
    catalog["updatedAt"] = released_at
    put_file(repo, branch, "catalog.json",
             (json.dumps(catalog, indent=2) + "\n").encode(),
             f"{info['name']} {name} (build {code})", catalog_sha)
    print("catalog updated")

    # Delete this app's releases beyond the newest `keep`.
    res = gh("release", "list", "--repo", repo, "--limit", "1000", "--json", "tagName,createdAt")
    if res.returncode == 0:
        mine = [r for r in json.loads(res.stdout) if r["tagName"].startswith(f"{pkg}-v")]
        mine.sort(key=lambda r: r["createdAt"], reverse=True)
        kept_tags = {r["tag"] for r in app["releases"]}
        for r in mine[keep:]:
            if r["tagName"] in kept_tags:
                continue
            if gh("release", "delete", r["tagName"], "--repo", repo, "--yes", "--cleanup-tag").returncode == 0:
                print(f"deleted old release {r['tagName']}")
    elif dropped:
        print("warning: could not list releases to clean up", file=sys.stderr)

    # Push notification.
    topic = cfg.get("ntfyTopic")
    if topic and not args.no_notify:
        server = cfg.get("ntfyServer", "https://ntfy.sh").rstrip("/")
        body = f"{info['name']} {name} (build {code}) is ready to install.\n{notes}"
        res = subprocess.run(
            ["curl", "-sS", "-f", "-o", "/dev/null",
             "-H", f"Title: {info['name']} update available",
             "-H", "Tags: panda_face,arrow_up",
             "-H", f"Click: pandastore://app/{pkg}",
             "-d", body, f"{server}/{topic}"],
            capture_output=True, text=True)
        print("phone notified" if res.returncode == 0 else f"warning: ntfy push failed: {res.stderr.strip()}")

    print(f"published {info['name']} v{name} (build {code})")


if __name__ == "__main__":
    main()
